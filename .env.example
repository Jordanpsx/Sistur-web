# Copy to .env — .env is gitignored and must never be committed.

# ── Sistur API ──────────────────────────────────────────────────────────────
# ⚠️ Always the CONTAINER-SPECIFIC hostname. The alias `sistur-flask` is
# registered by BOTH compose projects on rede_integrada_ia and resolves to two
# addresses — one staging, one production. Using it would make the destination
# non-deterministic. See Landing_plan.md §2.3.
SISTUR_API_URL=http://sistur-teste-sistur-flask-1:5000

# Authorization: Bearer — the same scheme the WordPress plugin already sends.
SISTUR_PUBLIC_TOKEN=

# ── Revalidation webhook ────────────────────────────────────────────────────
# Shared with the Sistur revalidation worker. Generate per environment; never
# reuse the production value here, and never derive it from Sistur's SECRET_KEY.
#   openssl rand -hex 32
REVALIDATE_SECRET=

# ── Site URL — SERVER-ONLY, read at runtime ─────────────────────────────────
# Not NEXT_PUBLIC_: those are inlined at BUILD time, which would freeze the
# canonical host into the image and stop one image serving both environments.
SITE_URL=https://test.cachoeiradogirassol.com.br

# ── Host port ───────────────────────────────────────────────────────────────
# 3000 is taken by chatwoot-rails-1.
APP_PORT=8082    # porta que o NPM roteia para test.cachoeiradogirassol.com.br

# Autoriza a suíte de integração a criar reservas de VERDADE no alvo apontado
# por SISTUR_API_URL. Deixe vazio em qualquer ambiente cuja lista de reservas
# alguém usa para trabalhar — os testes de leitura continuam rodando, só os de
# escrita se pulam. Nunca defina isto apontando para produção.
SISTUR_ALVO_DESCARTAVEL=
